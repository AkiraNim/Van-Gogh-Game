[signal arg="inv_sync"]
[signal arg="quest_add:Coletar legumes:legumes:{count_legumes}"]
if {q_Coletar legumes_status} == "completed":
	join Scot right [animation="Fade In Up"]
	Scot: Aqui estão os legumes, missão cumprida.
	[signal arg="remove_item:legumes:10"]
	leave --All--
	join Fazendeiro left [animation="Fade In Up"]
	Fazendeiro: Hm... Ótimo, bom trabalho voce fez por merecer.
	Fazendeiro: (Esse garoto é bom)
	leave --All--
	join Scot right [animation="Fade In Up"]
	Scot: Muito obrigado!
	leave --All--
	join Fazendeiro left [animation="Fade In Up"]
	Fazendeiro: Enfim, tome aqui suas preciosas flores.
	leave --All--
	[signal arg="npc_drop:flores_de_inverno"]
	[signal arg="npc_next:Fazendeiro"]
	[end_timeline]
else:
	leave --All--
	join Fazendeiro left [animation="Fade In Up"]
	Fazendeiro: Ta fazendo corpo mole pivete, trabalha!
	leave --All--
	join Scot right [animation="Fade In Up"]
	Scot: To dando o meu melhor...
	leave --All--
	[end_timeline]
leave --All--
[end_timeline]
