[signal arg="npc_drop:estrela_amarela"]
if {q_Coletar flores de inverno_status} == "accepted":
	join Scot right [animation="Fade In Up"]
	Scot: Bom dia fazendeiro, tudo bem?
	leave --All--
	join Fazendeiro right [animation="Fade In Up"]
	Fazendeiro: O que voce quer!?
	leave --All--
	join Scot right [animation="Fade In Up"]
	Scot: (Sussurra) grosso...
	leave --All--
	join Fazendeiro right [animation="Fade In Up"]
	Fazendeiro: O que voce disse?
	leave --All--
	join Scot right [animation="Fade In Up"]
	Scot: Nada não.
	Scot: A florista me mandou aqui para conseguir umas flores de inverno com voce.
	leave --All--
	join Fazendeiro right [animation="Fade In Up"]
	Fazendeiro: Sai daqui garoto, não faço caridade, ainda mais para estranhos.
	leave --All--
	join Scot right [animation="Fade In Up"]
	Scot: Então como eu posso te ajudar para conseguir as flores?
	leave --All--
	join Fazendeiro right [animation="Fade In Up"]
	Fazendeiro: Estou precisando que alguém colha 10 legumes para mim, será que voce dá conta?
	leave --All--
	join Scot right [animation="Fade In Up"]
	Scot: Pode deixar comigo!
	Scot: (To lascado)
	[signal arg="quest_accept:Coletar legumes:collect"]
	[signal arg="quest_set_req:Coletar legumes:legumes:10"]
	[signal arg="quest_add:Coletar legumes:legumes:{count_legumes}"]
	[signal arg="npc_next:Fazendeiro"]
	
else:
	join Scot right [animation="Fade In Up"]
	Scot: Bom dia senhor, sabe como saio desse lugar e volto pra casa?
	leave --All--
	join Fazendeiro right [animation="Fade In Up"]
	Fazendeiro: É simples, voce sai da minha frente e nunca mais volta.
	leave --All--
	join Scot right [animation="Fade In Up"]
	Scot: (Será que todo mundo aqui é mal educado?)
