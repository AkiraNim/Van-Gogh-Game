[signal arg="inv_sync"]
[signal arg="quest_add:Coletar flores de inverno:flores_de_inverno:{count_flores_de_inverno}"]
if {q_Coletar flores de inverno_status} == "completed":
	join Scot right [animation="Fade In Up"]
	Scot: Consegui as flores de inverno!
	leave --All--
	join Florista left [animation="Fade In Up"]
	Florista: Que notícia ótima, voce parece cansado deve ter se esforçado bastante.
	Florista: Como prometido, aqui está sua estrela.
	leave --All--
	join Scot right [animation="Fade In Up"]
	Scot: Muito obrigado!
	leave --All--
	join Florista left [animation="Fade In Up"]
	Florista: Faça bom proveito.
	leave --All--
	[signal arg="npc_drop:estrela"]
	[signal arg="remove_item:flores_de_inverno:1"]
	[signal arg="npc_next:Florista"]
	[end_timeline]
else:
	join Florista left [animation="Fade In Up"]
	Florista: Ainda não conseguiu as flores? Quer uma agua? Voce parece cansado
	leave --All--
	join Scot right [animation="Fade In Up"]
	Scot: Estou quase conseguindo elas, muito obrigado pela água.
	Scot: (Ela é tao gentil)
	leave --All--
	[end_timeline]
[end_timeline]
