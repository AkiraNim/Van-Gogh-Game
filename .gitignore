.godot/

## Godot 3 (compatibilidade)
*.import

## Export (bins e credenciais)
export_credentials.cfg
*.pck
*.zip
*.apk
*.aab

## Traduções compiladas
*.translation


# ================================ #
#        MONO / C# (Opcional)      #
# ================================ #
.mono/
data_*/
mono_crash.*.json


# ==================================================== #
#  Binários / Cache genéricos (boa prática)
# ==================================================== #

## Binários compilados
*.exe
*.exe.config
*.dll
*.so
*.dylib

## Pastas de build / cache
[Bb]uild/
[Bb]in/
[Cc]ache/
*.cache

## Arquivos do SO
.DS_Store
Thumbs.db
.nomedia


# ==================================================== #
#      Regras específicas do projeto (IMPORTANTE)
# ==================================================== #

# Se em algum momento você usou padrões amplos (ex.: "*", "/*", "Assets/**"),
# as exceções abaixo "reabrem" o caminho até a pasta dos .aseprite.

# Reabrir caminho até Assets (caso alguma regra anterior ignore a pasta)
!Assets/
!Assets/Scenarios/
!Assets/Scenarios/Enviroment/

# Permitir .aseprite nessa pasta (e subpastas)
!Assets/Scenarios/Enviroment/**/*.aseprite

# (Opcional) Se você também usa .ase, libere-os aqui:
!Assets/Scenarios/Enviroment/**/*.ase
